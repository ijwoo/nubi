{
  "app": "com.apple.Preferences",
  "start": "root",
  "launch": {
    "com.apple.Preferences": "root"
  },
  "screens": {
    "root": "./root.json",
    "accessibility": "./accessibility.json",
    "root-back": "./root-back.json",
    "general": "./general.json",
    "about": "./about.json",
    "search-focused": "./search-focused.json",
    "search-results": "./search-results.json"
  },
  "transitions": [
    {
      "from": "*",
      "tap": "com.apple.settings.accessibility",
      "to": "accessibility"
    },
    {
      "from": "accessibility",
      "back": true,
      "to": "root-back"
    },
    {
      "from": "*",
      "tap": "com.apple.settings.general",
      "to": "general"
    },
    {
      "from": "*",
      "tap": "About",
      "to": "about"
    },
    {
      "from": "about",
      "back": true,
      "to": "general"
    },
    {
      "from": "general",
      "back": true,
      "to": "root-back"
    },
    {
      "from": "*",
      "tap": "검색",
      "to": "search-focused"
    },
    {
      "from": "search-focused",
      "type": true,
      "to": "search-results"
    }
  ]
}

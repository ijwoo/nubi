{
  "name": "nubi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A voice-driven iPhone agent that learns a path once, then replays it without the model.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch bin/nubi.ts",
    "nubi": "tsx bin/nubi.ts",
    "mcp": "tsx bin/nubi-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:docs",
    "live": "tsx scripts/live-check.ts",
    "wda": "./scripts/wda.sh",
    "record": "tsx scripts/record.ts",
    "eval": "tsx scripts/eval.ts",
    "compare": "tsx scripts/compare-models.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
